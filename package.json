{
  "name": "kedovi",
  "version": "0.97.0",
  "private": false,
  "description": "Claude Code · Codex 팀 개발 워크스페이스 킷: 메인은 대화만, 작업은 리더 · 팀원 에이전트가 병렬로(3층 · 요금제별 상한) · 질문엔 답 먼저 · 채팅은 결론 + 자세히 링크(보고 페이지) · 착수 전 확인 → 검사 → 리뷰를 훅으로 지킴 · API · 배치 · 화면 실행 흐름 디버깅(Java · Python · React · Next.js · Node, 줄마다 값 · SQL · 요청을 웹으로) · 대화 중 기능 추천(정한 것은 다시 안 물음) · 한 규칙 두 도구 · 핸드오프 · 로드맵 · 기획 문서 사이트 · 화면 정본 대조(착수 전 막기 · 배치 대조 · 결정 없는 다름 막기)",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "hooks",
    "debugger",
    "execution-trace",
    "time-travel-debugging",
    "nextjs",
    "subagents",
    "workspace",
    "team",
    "handoff",
    "agents-md",
    "prototype-fidelity",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evrenjo/kedovi.git"
  },
  "bin": {
    "kedovi": "bin/kedovi.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1"
  },
  "files": [
    "bin",
    "packs",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.test.js",
    "!**/*.test.py",
    "!**/__pycache__",
    "!bin/selftest.js",
    "!bin/vendor.js",
    "!bin/site-test.js"
  ],
  "scripts": {
    "test": "node bin/selftest.js",
    "models": "node bin/models.js check",
    "models:doc": "node bin/models.js doc",
    "models:livebench": "node bin/models.js livebench",
    "models:watch": "node bin/models.js watch",
    "docs": "node bin/docs.js",
    "test:site": "node bin/site-test.js",
    "test:trace": "node bin/test-trace.js",
    "vendor": "node bin/vendor.js",
    "vendor:check": "node bin/vendor.js --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "homepage": "https://evrenjo.github.io/kedovi/",
  "bugs": {
    "url": "https://github.com/evrenjo/kedovi/issues"
  }
}
