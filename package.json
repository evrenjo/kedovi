{
  "name": "kedovi",
  "version": "0.112.0",
  "private": false,
  "description": "Claude Code · Codex 팀 개발 워크스페이스 킷: 메인은 대화, 작업은 리더 · 팀원 에이전트가 병렬로 · 의도 인터뷰 → 착수 전 확인 → 검사 → 리뷰를 훅으로 지킴 · 화면 품질 점검(WCAG 2.2 · KRDS) · 프로젝트 사이트(대시보드 · 일정 · 이슈 · 바뀐 점 비교) · 유형 · 분야 프로필 · 요청 장부 · IDE diff · 실행 흐름 디버깅",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "hooks",
    "debugger",
    "execution-trace",
    "time-travel-debugging",
    "nextjs",
    "subagents",
    "workspace",
    "team",
    "handoff",
    "agents-md",
    "prototype-fidelity",
    "writing-style",
    "test-queue",
    "usage-limits",
    "developer-tools",
    "git-worktree",
    "request-tracking",
    "ai-slop",
    "project-portal",
    "spec-driven-development",
    "asyncapi",
    "embedded",
    "game-development",
    "reverse-prompting",
    "ide-diff",
    "accessibility",
    "wcag",
    "krds",
    "ux-testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evrenjo/kedovi.git"
  },
  "bin": {
    "kedovi": "bin/kedovi.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1"
  },
  "files": [
    "bin",
    "packs",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.test.js",
    "!**/*.test.py",
    "!**/__pycache__",
    "!bin/selftest.js",
    "!bin/vendor.js",
    "!bin/site-test.js",
    "!bin/fixtures"
  ],
  "scripts": {
    "test": "node bin/selftest.js",
    "models": "node bin/models.js check",
    "models:doc": "node bin/models.js doc",
    "models:livebench": "node bin/models.js livebench",
    "models:watch": "node bin/models.js watch",
    "docs": "node bin/docs.js",
    "test:site": "node bin/site-test.js",
    "test:trace": "node bin/test-trace.js",
    "vendor": "node bin/vendor.js",
    "vendor:check": "node bin/vendor.js --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "homepage": "https://evrenjo.github.io/kedovi/",
  "bugs": {
    "url": "https://github.com/evrenjo/kedovi/issues"
  }
}
