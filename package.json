{
  "name": "kedovi",
  "version": "0.81.0",
  "private": false,
  "description": "Claude Code · Codex 겸용 AI 협업 워크스페이스 킷",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evrenjo/kedovi.git"
  },
  "bin": {
    "kedovi": "bin/kedovi.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1"
  },
  "files": [
    "bin",
    "packs",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.test.js",
    "!**/*.test.py",
    "!**/__pycache__",
    "!bin/selftest.js",
    "!bin/vendor.js",
    "!bin/site-test.js"
  ],
  "scripts": {
    "test": "node bin/selftest.js",
    "models": "node bin/models.js check",
    "models:doc": "node bin/models.js doc",
    "models:livebench": "node bin/models.js livebench",
    "models:watch": "node bin/models.js watch",
    "docs": "node bin/docs.js",
    "test:site": "node bin/site-test.js",
    "vendor": "node bin/vendor.js",
    "vendor:check": "node bin/vendor.js --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "homepage": "https://evrenjo.github.io/kedovi/",
  "bugs": {
    "url": "https://github.com/evrenjo/kedovi/issues"
  }
}
